# Environment variables for the application
APP_ENV=development
LOG_LEVEL=INFO

# Coinbase configuration
COINBASE_ENABLED=false
COINBASE_API_KEY=<YOUR_API_KEY>
COINBASE_API_SECRET=<YOUR_API_SECRET>

# Numerai configuration
NUMERAI_API_KEY_NAME=<YOUR_API_KEY_NAME>
NUMERAI_USERNAME=<YOUR_USERNAME>
NUMERAI_PUBLIC_ID=<YOUR_PUBLIC_ID>
NUMERAI_SECRET=<YOUR_SECRET>

# Gmail: previews by default; --send also requires GMAIL_ENABLED=true
GMAIL_ENABLED=false
GMAIL_USERNAME=<YOUR_EMAIL>
GMAIL_APP_PASSWORD=<YOUR_GOOGLE_APP_PASSWORD>
GMAIL_TO=<YOUR_EMAIL>
REPORT_TIMEZONE=UTC

# OpenAI configuration
LLM_ENABLED=false
OPENAI_API_KEY=sk-<YOUR_API_KEY>
OPENAI_MODEL=<YOUR_MODEL>
OPENAI_API_BASE_URL=<YOUR_API_BASE_URL>
